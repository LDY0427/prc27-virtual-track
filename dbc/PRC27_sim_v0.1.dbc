VERSION "PRC27_sim_v0.1 - SIMULATION ONLY. EMU_SIM_* is a placeholder, not the official EMU BLACK stream."


NS_ :
	CM_
	BA_DEF_
	BA_
	VAL_
	BA_DEF_DEF_

BS_:

BU_: ECU DAQ DASH WSS


BO_ 1536 EMU_SIM_0: 8 ECU
