BO_ 1713 WSS_TCS: 8 WSS
 SG_ WssValid : 0|4@1+ (1,0) [0|15] "" ECU,DAQ,DASH
 SG_ WssSeq : 4|4@1+ (1,0) [0|15] "" ECU,DAQ,DASH
 SG_ TcsMode : 8|4@1+ (1,0) [0|15] "" ECU,DAQ,DASH
 SG_ TcsReason : 12|4@1+ (1,0) [0|15] "" ECU,DAQ,DASH
 SG_ VehSpeedRef : 16|16@1+ (0.01,0) [0|655.34] "km/h" ECU,DAQ,DASH
 SG_ SlipDrive : 32|16@1- (0.001,0) [-32.767|32.767] "" ECU,DAQ,DASH
 SG_ TcsCutReq : 48|8@1+ (0.5,0) [0|100] "%" ECU,DAQ,DASH
 SG_ TcsSeq : 56|8@1+ (1,0) [0|255] "" ECU,DAQ,DASH


CM_ "Simulation DBC (2026-10-04, CLAUDE). DAQ_* frames copied from 01_설계/PRC27_DAQ_draft_v0.2.dbc. DAQ_Chassis, WSS_Speed, WSS_TCS are new proposals. EMU_SIM_* is a placeholder layout; replace with the official EMU BLACK CAN stream definition for the installed firmware. IDs are not checked against real ECU/zone node IDs.";
CM_ BO_ 1536 "PLACEHOLDER - not the official EMU BLACK layout.";
CM_ BO_ 1537 "PLACEHOLDER - not the official EMU BLACK layout.";
CM_ SG_ 1664 T1 "Raw 0xFFF = invalid. Valid bit0..3 = T1..T4.";
CM_ SG_ 1665 ShockFL "Raw 0xFFF = invalid. Sat bit0..3 = FL,FR,RL,RR ADC saturation.";
CM_ SG_ 1668 ChassisValid "bit0 steer, bit1 brake front, bit2 brake rear.";
CM_ SG_ 1712 WssFL "Raw 0xFFFF = invalid.";
CM_ SG_ 1713 WssValid "bit0..3 = FL,FR,RL,RR sensor-level valid (module self check).";
CM_ SG_ 1713 SlipDrive "(driven - reference)/max(reference, floor). Raw 0x8000 = invalid.";
CM_ SG_ 1696 DaqErrFlags "bit0 SD error, bit1 GNSS no fix, bit2 IMU error, bit3 SENS5V_A fault, bit4 SENS5V_B fault, bit5 power fail seen, bit6 buffer overflow, bit7 UTC unsynced, bit8 CAN2 error, bit9 NTC excitation fault";

VAL_ 1696 LogState 0 "BOOT" 1 "WAIT_SD" 2 "LOGGING" 3 "NO_CARD" 4 "SD_RECOVER" 5 "SD_FAILED" 6 "CARD_FULL" 7 "PFI_FLUSH" 8 "SHUTDOWN" ;
VAL_ 1681 FixType 0 "NO_FIX" 1 "DEAD_RECKONING" 2 "FIX_2D" 3 "FIX_3D" 4 "GNSS_DR" 5 "TIME_ONLY" ;
VAL_ 1713 TcsMode 0 "OFF" 1 "STANDBY" 2 "ACTIVE" 3 "FAULT" ;
VAL_ 1713 TcsReason 0 "NONE" 1 "SWITCH_OFF" 2 "WSS_INVALID" 3 "CAN_TIMEOUT" 4 "LOW_TPS" ;
